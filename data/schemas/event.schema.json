{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rubbishbro/Optical-Fruit-Simulation/event.schema.json",
  "title": "Fruitsim replayable server event",
  "type": "object",
  "required": ["protocol", "type", "seq", "event_id", "run_id", "kind", "stage", "status", "server_ts", "payload"],
  "properties": {
    "protocol": {"const": 1},
    "type": {"const": "event"},
    "seq": {"type": "integer", "minimum": 1},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "run_id": {"type": ["string", "null"]},
    "kind": {"type": "string", "minLength": 1, "maxLength": 160},
    "stage": {"type": "string", "minLength": 1, "maxLength": 160},
    "status": {"type": "string", "minLength": 1, "maxLength": 160},
    "server_ts": {"type": "string", "minLength": 1},
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
