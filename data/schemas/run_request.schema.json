{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rubbishbro/Optical-Fruit-Simulation/run_request.schema.json",
  "title": "fruitsim run request",
  "type": "object",
  "required": ["schema_version", "run_id", "source_type", "seed", "output_dir", "steps"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "source_type": {"$ref": "run_manifest.schema.json#/properties/source_type"},
    "seed": {"type": "integer", "minimum": 0},
    "output_dir": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["generate", "simulate", "postprocess", "train", "visualize"]}
    },
    "simulation_config": {"type": ["string", "null"]},
    "ml_config": {"type": ["string", "null"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
