{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rubbishbro/Optical-Fruit-Simulation/artifact_index.schema.json",
  "title": "fruitsim run artifact index",
  "type": "object",
  "required": ["schema_version", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/artifact"}
    }
  },
  "additionalProperties": false,
  "definitions": {
    "artifact": {
      "type": "object",
      "required": ["artifact_id", "role", "relative_path", "media_type", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "relative_path": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "schema_version": {"type": ["integer", "null"], "minimum": 1},
        "producer": {"type": ["string", "null"]},
        "unit": {"type": ["string", "null"]},
        "shape": {"type": ["array", "null"], "items": {"type": "integer", "minimum": 0}},
        "dtype": {"type": ["string", "null"]},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      },
      "additionalProperties": false
    }
  }
}
