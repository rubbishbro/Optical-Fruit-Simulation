{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rubbishbro/Optical-Fruit-Simulation/run_status.schema.json",
  "title": "fruitsim run status",
  "type": "object",
  "required": ["schema_version", "run_id", "state", "updated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "state": {"$ref": "#/definitions/state"},
    "stage": {"type": ["string", "null"]},
    "completed": {"type": "integer", "minimum": 0},
    "total": {"type": "integer", "minimum": 0},
    "message": {"type": ["string", "null"]},
    "error_code": {"type": ["string", "null"]},
    "updated_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "definitions": {
    "state": {
      "enum": [
        "created",
        "validating",
        "queued",
        "generating_data",
        "simulating",
        "postprocessing",
        "preprocessing",
        "training",
        "evaluating",
        "rendering",
        "completed",
        "failed",
        "cancelling",
        "cancelled"
      ]
    }
  }
}
