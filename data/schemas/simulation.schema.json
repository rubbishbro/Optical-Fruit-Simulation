{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rubbishbro/Optical-Fruit-Simulation/simulation.schema.json",
  "title": "fruitsim simulation configuration",
  "type": "object",
  "required": ["schema_version", "session", "domain", "source", "spectra"],
  "properties": {
    "schema_version": {"const": 1},
    "session": {
      "type": "object",
      "required": ["photons_per_wavelength", "transport_mode"],
      "properties": {
        "transport_mode": {"const": "scalar"},
        "photons_per_wavelength": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer", "minimum": 0},
        "batch_size": {"type": "integer", "minimum": 1},
        "max_reduction_batches": {"type": "integer", "minimum": 1},
        "max_events": {"type": "integer", "minimum": 1},
        "boundary_epsilon_mm": {"type": "number", "exclusiveMinimum": 0},
        "backend": {"enum": ["cpu", "cuda"]}
      }
    },
    "domain": {
      "type": "object",
      "required": ["type", "layers_inner_to_outer"],
      "properties": {
        "type": {"const": "layered_sphere"},
        "exterior_refractive_index": {"type": "number", "exclusiveMinimum": 0},
        "layers_inner_to_outer": {"type": "array", "minItems": 1}
      }
    },
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["pencil", "gaussian", "ring"]},
        "position_mm": {"$ref": "#/$defs/vec3"},
        "direction": {"$ref": "#/$defs/vec3"},
        "sigma_mm": {"type": "number", "exclusiveMinimum": 0},
        "center_mm": {"$ref": "#/$defs/vec3"},
        "plane_normal": {"$ref": "#/$defs/vec3"},
        "ring_radius_mm": {"type": "number", "exclusiveMinimum": 0},
        "ring_width_mm": {"type": "number", "minimum": 0},
        "direction_mode": {"enum": ["fixed", "aim_at"]},
        "target_mm": {"$ref": "#/$defs/vec3"},
        "spatial_sampling": {"enum": ["uniform_azimuth", "uniform_area"]}
      }
    },
    "instrument": {
      "type": "object",
      "properties": {
        "detector": {
          "type": "object",
          "required": ["center_mm", "axis", "radius_mm"],
          "properties": {
            "enabled": {"type": "boolean"},
            "type": {"const": "circular"},
            "center_mm": {"$ref": "#/$defs/vec3"},
            "axis": {
              "allOf": [{"$ref": "#/$defs/vec3"}],
              "description": "Detector-plane normal pointing from detector toward sample; accepted light travels around -axis"
            },
            "radius_mm": {"type": "number", "exclusiveMinimum": 0},
            "numerical_aperture": {
              "type": "number",
              "minimum": 0,
              "description": "NA in the exterior detector medium: n_exterior*sin(theta_max)"
            },
            "acceptance_half_angle_deg": {
              "type": "number", "minimum": 0, "maximum": 90
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "spectra": {"type": "array", "minItems": 1},
    "scoring": {"type": "object"},
    "roulette": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "vec3": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}],
      "minItems": 3,
      "maxItems": 3
    }
  }
}
