{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rubbishbro/Optical-Fruit-Simulation/simulation.schema.json",
  "title": "fruitsim simulation configuration",
  "type": "object",
  "required": ["schema_version", "session", "domain", "source", "spectra"],
  "properties": {
    "schema_version": {"const": 1},
    "session": {
      "type": "object",
      "required": ["photons_per_wavelength", "transport_mode"],
      "properties": {
        "transport_mode": {"const": "scalar"},
        "photons_per_wavelength": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer", "minimum": 0},
        "backend": {"enum": ["cpu", "cuda"]}
      }
    },
    "domain": {
      "type": "object",
      "required": ["type", "layers_inner_to_outer"],
      "properties": {
        "type": {"const": "layered_sphere"},
        "exterior_refractive_index": {"type": "number", "exclusiveMinimum": 0},
        "layers_inner_to_outer": {"type": "array", "minItems": 1}
      }
    },
    "source": {"type": "object"},
    "spectra": {"type": "array", "minItems": 1},
    "scoring": {"type": "object"},
    "roulette": {"type": "object"}
  },
  "additionalProperties": false
}
